# ============================================
# HOUSE CRM - Variables de Entorno
# Copia este archivo como .env y rellena los valores
# ============================================

# Supabase (obligatorio)
VITE_SUPA_URL=https://tu-proyecto.supabase.co
VITE_SUPA_KEY=tu-anon-key-aqui

# Google OAuth (obligatorio)
VITE_GID=tu-client-id.apps.googleusercontent.com

# Cloudinary (opcional, usar si quieres cambiar de cuenta)
VITE_CLOUD_NAME=tu-cloud-name
VITE_CLOUD_PRESET=tu-preset-unsigned
